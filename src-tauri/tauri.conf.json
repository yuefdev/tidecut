{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "astral-lunar",
  "version": "0.1.0",
  "identifier": "com.hp.astral-lunar",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "astral-lunar",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*.[mM][pP]4",
          "**/*.[mM]4[vV]",
          "**/*.[mM][oO][vV]",
          "**/*.[aA][vV][iI]",
          "**/*.[mM][kK][vV]",
          "**/*.[wW][eE][bB][mM]",
          "**/*.[mM][xX][fF]",
          "**/*.[tT][sS]",
          "**/*.[mM][tT][sS]",
          "**/*.[mM]2[tT][sS]",
          "**/*.[wW][mM][vV]",
          "**/*.[fF][lL][vV]",
          "**/*.[oO][gG][vV]",
          "**/*.[mM][pP]3",
          "**/*.[wW][aA][vV]",
          "**/*.[mM]4[aA]",
          "**/*.[aA][aA][cC]",
          "**/*.[fF][lL][aA][cC]",
          "**/*.[oO][gG][gG]",
          "**/*.[oO][pP][uU][sS]",
          "**/*.[aA][iI][fF]",
          "**/*.[aA][iI][fF][fF]",
          "**/*.[wW][mM][aA]",
          "**/*.[pP][nN][gG]",
          "**/*.[jJ][pP][gG]",
          "**/*.[jJ][pP][eE][gG]",
          "**/*.[wW][eE][bB][pP]",
          "**/*.[gG][iI][fF]",
          "**/*.[bB][mM][pP]",
          "**/*.[tT][iI][fF]",
          "**/*.[tT][iI][fF][fF]",
          "**/*.[aA][vV][iI][fF]",
          "**/*.[hH][eE][iI][cC]",
          "**/*.[hH][eE][iI][fF]",
          "**/*.[sS][vV][gG]"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
